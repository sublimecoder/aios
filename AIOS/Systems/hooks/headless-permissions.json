{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD)",
      "Bash(git pull --rebase)",
      "Bash(git pull --rebase origin main)",
